# memini-ai-dev — Environment Variables
# Copy this file to .env and adjust values for your environment.

# =============================================================================
# Core Database Settings
# =============================================================================
MEMINI_DB_URL=postgresql://postgres:password@localhost:5434/postgres
MEMINI_PROJECT_ID=my-project
MEMINI_EMBEDDING_DIM=384

# =============================================================================
# Vector Backend Selection (v1.0.0+)
# =============================================================================
# Controls where memini-ai stores its vector embeddings.
#
#   pgembed          — In-process embedded PostgreSQL 17 (DEFAULT for new
#                     installs). No Docker required. Data stored in
#                     MEMINI_PGEMBED_DATA_DIR.
#   postgres-external — Connect to an external PostgreSQL server via
#                     MEMINI_DB_URL (v0.8.x behaviour). REQUIRED if you have
#                     MEMINI_DB_URL set.
#
# WARNING: v1.0.0 breaking change — if you have MEMINI_DB_URL set (from v0.8.x),
# you MUST also set MEMINI_VECTOR_BACKEND=postgres-external or the server
# refuses to start. Either fix the env or run
#   memini-ai migrate --from='<your old MEMINI_DB_URL>'
# to copy data to embedded mode.
MEMINI_VECTOR_BACKEND=pgembed

# Data directory for the embedded pgembed PostgreSQL instance (XDG-compliant).
# Only used when MEMINI_VECTOR_BACKEND=pgembed.
MEMINI_PGEMBED_DATA_DIR=~/.local/share/memini-ai/pgembed/data

# =============================================================================
# PostgreSQL TLS/SSL Configuration
# =============================================================================
# SSL mode controls how PostgreSQL connections handle encryption.
# See: https://www.postgresql.org/docs/current/libpq-ssl.html
#
# Values:
#   disable     — No SSL, plaintext only (NOT recommended for production)
#   allow       — Try without SSL first, fall back to SSL (rarely useful)
#   prefer      — Try SSL first, fall back to plaintext (DEFAULT for dev)
#   require     — SSL required, but server identity not verified
#   verify-ca   — SSL required, CA certificate verified
#   verify-full — SSL required, CA cert + hostname verified (RECOMMENDED for prod)
DB_SSLMODE=prefer

# Path to CA certificate file for server verification.
# Required when DB_SSLMODE is verify-ca or verify-full.
# For Docker deployments, this typically points to a mounted volume:
#   DB_SSLROOTCERT=/certs/ca.crt
DB_SSLROOTCERT=

# =============================================================================
# Advanced Feature Toggles
# =============================================================================
# Set to "true" to enable any of these features.
THOUGHT_CHAINS=false
MEMINI_TRUST_ENGINE=false
MEMINI_TIERED_LOADING=false
MEMINI_KG_ENABLED=false
MEMINI_MEMORY_GRAPH=false
MEMINI_DIALECTIC_ENABLED=false
MEMINI_MULTI_PEER_ENABLED=false
MEMINI_USER_MODELING=false
MEMINI_DECAY_ENABLED=false
MEMINI_AUTO_EXTRACT=false
MEMINI_PRECOMPRESS=false

# =============================================================================
# Dual-Model RRF (v0.7.0+)
# =============================================================================
# Embedding mode controls how memories are written and queried:
#   cpu  — 384-dim only (legacy / lowest-memory mode)
#   auto — 384-dim writes + 1024-dim sidecar on elevation; queries fuse
#          both via Reciprocal Rank Fusion (RRF, k=60)
#   gpu  — 1024-dim only (the 384-dim write is mirrored to the 1024
#          sidecar at insert time)
EMBEDDING_MODE=auto

# When true, the elevate_memory_to_1024 MCP tool is available.
# When false, the tool is registered but refuses calls (returns error).
ELEVATE_ENABLED=true

# RRF k constant (default 60 from Cormack et al. SIGIR 2009).
# Higher values flatten the contribution curve; lower values emphasize
# top ranks. Clamped to [1, 1000] by config validator.
RRF_K=60

# Where the background chat-log extractor writes its rolling buffer.
AUTO_EXTRACT_LOG_DIR=~/.memini-ai/chat_logs

# Background extractor poll interval in seconds (clamped to [1, 3600]).
AUTO_EXTRACT_INTERVAL_SECONDS=5


# v0.7.7+ Model Selection
# When True (default), new deployments (0 memories) auto-upgrade to BGE-M3 (1024-dim).
# Existing deployments keep their configured model.
MEMINI_AUTO_DETECT_MODEL=true

# When True, dim mismatch raises RuntimeError at load time (old behavior).
# When False (default), dim mismatch logs a warning and degrades to text-only search.
MEMINI_STRICT_EMBEDDING_DIM=false

# The active embedding model. Supported: all-MiniLM-L6-v2 (384), BAAI/bge-m3 (1024).
# Aliases: 'minilm', 'minilm-l6-v2', 'bge-m3'.
MEMINI_MODEL_NAME=all-MiniLM-L6-v2

# When True, query_memories merges results from all model spaces via RRF.
MEMINI_ENABLE_RRF=true

# How many results to fetch from each model's vector space before fusion.
RRF_TOP_K_PER_MODEL=20

# All models the system knows about (for RRF query dispatch).
# JSON list format. Default: ["all-MiniLM-L6-v2", "BAAI/bge-m3"]
MEMINI_ENABLED_MODELS=["all-MiniLM-L6-v2", "BAAI/bge-m3"]


# v1.5.6+ Operation Timeout
# Per-MCP-tool-call timeout ceiling in milliseconds (default 30000 = 30s).
# Previously hard-coded at 30s; raise it if large-memory writes on slow CPU
# embedding backends (e.g. BGE-M3 on long text) hit MCP -32001 timeouts.
# Clamped to [1000, 600000].
MEMINI_OPERATION_TIMEOUT_MS=30000
