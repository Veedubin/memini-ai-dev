# memini-ai-dev — Environment Variables
# Copy this file to .env and adjust values for your environment.

# =============================================================================
# Core Database Settings
# =============================================================================
MEMINI_DB_URL=postgresql://postgres:password@localhost:5434/postgres
MEMINI_PROJECT_ID=my-project
MEMINI_EMBEDDING_DIM=384

# =============================================================================
# PostgreSQL TLS/SSL Configuration
# =============================================================================
# SSL mode controls how PostgreSQL connections handle encryption.
# See: https://www.postgresql.org/docs/current/libpq-ssl.html
#
# Values:
#   disable     — No SSL, plaintext only (NOT recommended for production)
#   allow       — Try without SSL first, fall back to SSL (rarely useful)
#   prefer      — Try SSL first, fall back to plaintext (DEFAULT for dev)
#   require     — SSL required, but server identity not verified
#   verify-ca   — SSL required, CA certificate verified
#   verify-full — SSL required, CA cert + hostname verified (RECOMMENDED for prod)
DB_SSLMODE=prefer

# Path to CA certificate file for server verification.
# Required when DB_SSLMODE is verify-ca or verify-full.
# For Docker deployments, this typically points to a mounted volume:
#   DB_SSLROOTCERT=/certs/ca.crt
DB_SSLROOTCERT=

# =============================================================================
# Advanced Feature Toggles
# =============================================================================
# Set to "true" to enable any of these features.
THOUGHT_CHAINS=false
MEMINI_TRUST_ENGINE=false
MEMINI_TIERED_LOADING=false
MEMINI_KG_ENABLED=false
MEMINI_MEMORY_GRAPH=false
MEMINI_DIALECTIC_ENABLED=false
MEMINI_MULTI_PEER_ENABLED=false
MEMINI_USER_MODELING=false
MEMINI_DECAY_ENABLED=false
MEMINI_AUTO_EXTRACT=false
MEMINI_PRECOMPRESS=false